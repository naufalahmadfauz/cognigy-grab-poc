ource="n3" target="n4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n12" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="n4" target="n5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n13" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="n6" target="n7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n14" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="n7" target="n8"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n15" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="n8" target="n9"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n16" value="yes" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="n5" target="n6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n17" value="no" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0.5;entryY=0;" edge="1" parent="1" source="n5" target="n10"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n18" value='&lt;b&gt;Inside Code: Transfer Decision&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;yes&lt;/b&gt; → transfer.executed = true, result transferred_mock, uc4Go = true (no actions.output)&lt;br&gt;&lt;b&gt;unclear, first time&lt;/b&gt; → unclearOnce = true; deliver_guided: ask once more in other words&lt;br&gt;&lt;b&gt;otherwise (no)&lt;/b&gt; → declined = true, offered = false, then:&lt;br&gt;&amp;#160;&amp;#160;reason language → &lt;b&gt;end_call&lt;/b&gt; (exit_type language_not_supported)&lt;br&gt;&amp;#160;&amp;#160;reason other_brand → &lt;b&gt;steer_back&lt;/b&gt; guided.continueOrder&lt;br&gt;&amp;#160;&amp;#160;any other → &lt;b&gt;deliver_guided&lt;/b&gt; guided.declinedPerson&lt;br&gt;Only the no and unclear branches call actions.output("", out).' style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=10;" vertex="1" parent="1"><mxGeometry x="30" y="740" width="470" height="150" as="geometry"/></mxCell><mxCell id="n19" value="&lt;b&gt;AI Agent Tool: escalate_safety&lt;/b&gt;&lt;br&gt;Condition: none (always available)&lt;br&gt;Params: summary&lt;br&gt;&lt;i&gt;Band 2&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="560" y="70" width="270" height="90" as="geometry"/></mxCell><mxCell id="n20" value="&lt;b&gt;Code: Safety&lt;/b&gt;&lt;br&gt;reason safety, executed, result safety,&lt;br&gt;status handed_over, safetySummary" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=11;" vertex="1" parent="1"><mxGeometry x="560" y="195" width="270" height="62" as="geometry"/></mxCell><mxCell id="n21" value="Code: Build ACW" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=11;" vertex="1" parent="1"><mxGeometry x="560" y="290" width="270" height="50" as="geometry"/></mxCell><mxCell id="n22" value="&lt;b&gt;Say&lt;/b&gt; {{context.uc4Cfg.messages.safety}}&lt;br&gt;&lt;i&gt;call local emergency number&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1"><mxGeometry x="560" y="370" width="270" height="56" as="geometry"/></mxCell><mxCell id="n23" value="&lt;b&gt;
arent="1"><mxGeometry x="880" y="70" width="270" height="90" as="geometry"/></mxCell><mxCell id="n31" value="&lt;b&gt;Code: End Call&lt;/b&gt;&lt;br&gt;exit_type → input.uc4ExitMsg&lt;br&gt;(exitClosingA, exitDisengaged,&lt;br&gt;exitCouldNotResolve, exitLanguage);&lt;br&gt;result if empty; closingSaid = true" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=11;" vertex="1" parent="1"><mxGeometry x="880" y="195" width="270" height="96" as="geometry"/></mxCell><mxCell id="n32" value="Code: Build ACW" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=11;" vertex="1" parent="1"><mxGeometry x="880" y="325" width="270" height="50" as="geometry"/></mxCell><mxCell id="n33" value="&lt;b&gt;Say&lt;/b&gt; {{input.uc4ExitMsg}}" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1"><mxGeometry x="880" y="405" width="270" height="50" as="geometry"/></mxCell><mxCell id="n34" value="Hang Up" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="880" y="485" width="270" height="46" as="geometry"/></mxCell><mxCell id="n35" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="n30" target="n31"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n36" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="n31" target="n32"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n37" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="n32" target="n33"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n38" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="n33" target="n34"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n39" value="&lt;b&gt;Code: Build ACW&lt;/b&gt; (one shared node design, built once per path): writes context.shortTermMemory.uc4Acw with uc, lob, sessionId, orders, journeys, platform, lastStep, result, transferReason, classification ('others' when transferred), language, languageSwitches, safetySummary.&lt;br&gt;&lt;b&gt;Terminal rule:&lt;/b&gt; plain Say nodes from config only; the LLM never speaks after these." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=10;" vertex="1" parent="1"><mxGeometry x="560" y="620" width="590" height="90" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
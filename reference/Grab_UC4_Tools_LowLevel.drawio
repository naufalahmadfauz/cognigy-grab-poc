ned).&lt;br&gt;one_by_one: say = step.do + step.check.  all_at_once: join every step.do in the same chunk, then the chunk's last check.&lt;br&gt;{evidence} is replaced with cfg.evidence[lob]. If the segment is a portal one, walk.portalOpened = true." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=10;" vertex="1" parent="1"><mxGeometry x="330" y="900" width="840" height="58" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="6_advance_walkthroug" name="6 advance_walkthrough"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1300" pageHeight="1800" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="n2" value="advance_walkthrough: nodes and logic (6.11)" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=18;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="30" y="10" width="900" height="30" as="geometry"/></mxCell><mxCell id="n3" value="&lt;b&gt;AI Agent Tool: advance_walkthrough&lt;/b&gt;&lt;br&gt;Condition: uc4.walk.status === active&lt;br&gt;Params: outcome, step_id, new_platform, screen_description" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="30" y="80" width="250" height="90" as="geometry"/></mxCell><mxCell id="n4" value="&lt;b&gt;Code: advance_walkthrough&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=11;" vertex="1" parent="1"><mxGeometry x="30" y="204" width="250" height="62" as="geometry"/></mxCell><mxCell id="n5" value="&lt;b&gt;Resolve Tool Action&lt;/b&gt;&lt;br&gt;back to AI Agent" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="30" y="300" width="250" height="62" as="geometry"/></mxCell><mxCell id="n6" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="n3" target="n4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n7" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="n4" target="n5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n8" value="&lt;b&gt;Helpers inside the Code node&lt;/b&gt; (no return; each sets out)&lt;br&gt;&lt;br&gt;&lt;b&gt;deliver(lead)&lt;/b&gt;: current step or chunk → deliver_step verbatim&lt;br&gt;&lt;b&gt;startSegment(seg, lead)&lt;/b&gt;: reset counters, deliver step 1&lt;br&gt;&lt;b&gt;finish(guide, fixed)&lt;/b&gt;: status completed → deliver_say fixed + udr, or deliver_guided guide + anything else&lt;br&gt;&lt;b&gt;markSubmitted()&lt;/b&gt;: order.submitted → finish(afterSubmission)&lt;br&gt;&lt;b&gt;offer(reason, lead)&lt;/b&gt;: if declined → finish(softClose); else transfer.offered → offer_transfer&lt;br&gt;&lt;b&gt;toSubmit(lead)&lt;/b&gt;: portal → portal_submit; details open → app_submit; food_app_status → order_id step then app_submit; else app_view_order then app_submit&lt;br&gt;&lt;b&gt;segmentEnd()&lt;/b&gt;: history → back to order_id; portal_status → compensated; submit segments → markSubmitted; then = app_submit → app_submit; else orderVisible (awaiting submit_choice)&lt;br&gt;&lt;b&gt;roleStep()&lt;/b&gt;: first time → roleReminder (awaiting role_retry); retries left → reminder again; else offer(role_failed)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=10;" vertex="1" parent="1"><mxGeometry x="30" y="406" width="250" height="420" as="geometry"/></mxCell><mxCell id="n9" value="Inside Code: advance_walkthrough" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#999999;dashed=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="315" y="40" width="885" height="2674" as="geometry"/></mxCell><mxCell id="n10" value="runs" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.03;dashed=1;" edge="1" parent="1" source="n4" target="n9"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n11" value="step_id given and found → stepIndex = that step" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=10;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="330" y="80" width="300" height="52" as="geometry"/></mxCell><mxCell id="n12" value="outcome order_not_visible on a view segment → treat as failed" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=10;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="330" y="150" width="300" height="52" as="geometry"/></mxCell><mxCell id="n13" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="n11" target="n12"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n14" value="confirmed ?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;" vertex="1" parent="1"><mxGeometry x="330" y="220" width="300" height="74" as="geometry"/></mxCell><mxCell id="n15" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="n12" target="n14"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n16" value="stuckCount = 0; last step ? &lt;b&gt;segmentEnd()&lt;/b&gt; : next step, &lt;b&gt;deliver()&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f0f7ff;strokeColor=#6c8ebf;fontSize=10;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="700" y="225" width="470" height="64" as="geometry"/></mxCell><mxCell id="n17" value="yes" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="n14" target="n16"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n18" value="failed ?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;" vertex="1" parent="1"><mxGeometry x="330" y="316" width="300" height="74" as="geometry"/></mxCell><mxCell id="n19" value="no" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="n14" target="n18"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n20" value="stuckCount + 1, rung = stuckLadder[stuckCount-1]&lt;br&gt;repeat → deliver_step same step | clarify → deliver_guided | offer → &lt;b&gt;offer(difficulty_cap)&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f0f7ff;strokeColor=#6c8ebf;fontSize=10;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="700" y="321" width="470" height="64" as="geometry"/></mxCell><mxCell id="n21" value="yes" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="n18" target="n20"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n22" value="needs_time ?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;" vertex="1" parent="1"><mxGeometry x="330" y="412" width="300" height="74" as="geometry"/></mxCell><mxCell id="n23" value="no" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="n18" target="n22"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n24" value="&lt;b&gt;hold&lt;/b&gt;, guide walkGuided.hold (no counters)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f0f7ff;strokeColor=#6c8ebf;fontSize=10;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="700" y="417" width="470" height="64" as="geometry"/></mxCell><mxCell id="n25" value="yes" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="n22" target="n24"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n26" value="order_not_visible AND&lt;br&gt;food_app_status ?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;" vertex="1" parent="1"><mxGeometry x="330" y="508" width="300" height="74" as="geometry"/></mxCell><mxCell id="n27" value="no" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="n22" target="n26"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n28" value="startSegment(&lt;b&gt;food_app_history&lt;/b&gt;), keep then" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f0f7ff;strokeColor=#6c8ebf;fontSize=10;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="700" y="513" width="470" height="64" as="geometry"/></mxCell><mxCell id="n29" value="yes" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="n26" target="n28"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n30" value="order_not_visible ?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;" vertex="1" parent="1"><mxGeometry x="330" y="604" width="300" height="74" as="geometry"/></mxCell><mxCell id="n3